{
  "name": "h5p-generate-configs",
  "version": "1.0.0",
  "description": "h5p-generate-configs CLI",
  "homepage": "https://github.com/boyum/h5p-types/tree/main/packages/h5p-generate-configs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boyum/h5p-types.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "h5p-generate-configs": "./bin/run.js"
  },
  "files": [
    "/bin",
    "/dist"
  ],
  "scripts": {
    "build": "shx rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:library": "h5p-generate-configs l --type-definition demo/library.ts --out demo/library.json",
    "demo:semantics": "h5p-generate-configs s --type-definition demo/semantics.ts --out demo/semantics.json -t demo/TranslationKey.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "publish-to-npm": "release-it",
    "test": "npm run test:unit",
    "test:unit": "jest --passWithNoTests",
    "test:unit:coverage": "jest --coverage --passWithNoTests",
    "test:unit:watch": "jest --watch"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.30",
    "h5p-types": "*",
    "jest": "^30.5.2",
    "release-it": "^21.1.0",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  }
}
