{
  "name": "use-h5p",
  "version": "2.1.0",
  "description": "React Hooks to be used with H5P",
  "keywords": [
    "h5p",
    "react"
  ],
  "homepage": "https://github.com/boyum/h5p-types/tree/main/packages/use-h5p#readme",
  "bugs": {
    "url": "https://github.com/boyum/h5p-types/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boyum/h5p-types.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Sindre Bøyum",
    "url": "https://sinre.dev"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.cts",
  "files": [
    "dist/**/*",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsup ./src/index.ts --format esm,cjs --dts",
    "publish-to-npm": "release-it",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.17.30",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "h5p-types": "*",
    "h5p-utils": "*",
    "happy-dom": "^20.14.0",
    "react-dom": "^19.2.8",
    "release-it": "^21.0.2",
    "tsconfig-react": "*",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">= 17.0.1"
  }
}
