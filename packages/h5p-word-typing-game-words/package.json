{
  "name": "h5p-word-typing-game-words",
  "version": "1.0.0",
  "description": "Word lists for the H5P Word Typing Game content type.",
  "keywords": [
    "h5p",
    "words",
    "typing-game"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./en": {
      "import": {
        "types": "./dist/en.d.ts",
        "default": "./dist/en.js"
      },
      "require": {
        "types": "./dist/en.d.cts",
        "default": "./dist/en.cjs"
      }
    },
    "./nb": {
      "import": {
        "types": "./dist/nb.d.ts",
        "default": "./dist/nb.js"
      },
      "require": {
        "types": "./dist/nb.d.cts",
        "default": "./dist/nb.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.cts",
  "files": [
    "dist/**/*",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts"
  },
  "devDependencies": {
    "tsconfig-base": "*",
    "tsup": "^8.5.1",
    "typescript": "^5.0.4"
  }
}
