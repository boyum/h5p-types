{
  "name": "h5p-types-root",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Sindre Bøyum",
    "url": "https://sinre.dev"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "internal-utilities/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "code-style": "biome ci .",
    "code-style:fix": "biome check . --write",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate-monorepo": "sherif --ignore-dependency typescript"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^20.17.30",
    "sherif": "^1.13.0",
    "turbo": "^2.10.12",
    "webpack-cli": "^7.2.3"
  },
  "packageManager": "npm@12.0.2"
}
